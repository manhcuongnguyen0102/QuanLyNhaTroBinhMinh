@model QuanLyNhaTroBinhMinh.Models.ChiSoDienNuoc

@{
    ViewData["Title"] = "Chỉnh sửa chỉ số điện nước";
    var dsAnhHienTai = string.IsNullOrWhiteSpace(Model.AnhDongHo)
        ? Array.Empty<string>()
        : Model.AnhDongHo.Split(';', StringSplitOptions.RemoveEmptyEntries)
                         .Where(p => p.StartsWith("/uploads/"))
                         .ToArray();
}

<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">ĐIỀU CHỈNH CHỈ SỐ & ẢNH MINH CHỨNG</span>
        <h1 class="editorial-title mb-1">Sửa phiếu chốt #@Model.MaChiSo</h1>
        <p class="editorial-subtitle mb-0">Phòng: @Model.MaPhong — Kỳ: Tháng @(Model.Thang?.ToString("D2"))/@Model.Nam</p>
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert-editorial-danger mb-4"
         style="background-color: #FEF2F2; border: 1px solid #F87171; color: #991B1B; padding: 1rem 1.25rem; border-radius: 2px; font-weight: 600;">
        <div asp-validation-summary="All" class="small mb-0"></div>
    </div>
}

<div class="row">
    <div class="col-xl-8 col-lg-10">
        <div class="card">
            <div class="card-header">Hồ sơ chốt đồng hồ — Mã: @Model.MaChiSo</div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div class="form-row">
                        <div class="form-group col-md-3 mb-4">
                            <label asp-for="MaChiSo" class="editorial-label">Mã phiếu (Cố định)</label>
                            <input asp-for="MaChiSo" class="form-control" readonly style="background-color: #F9FAFB !important;" />
                        </div>

                        <div class="form-group col-md-5 mb-4">
                            <label asp-for="MaPhong" class="editorial-label">Phòng trọ *</label>
                            <select asp-for="MaPhong" asp-items="ViewBag.DanhSachPhong" class="form-control" required></select>
                        </div>

                        <div class="form-group col-md-2 mb-4">
                            <label asp-for="Thang" class="editorial-label">Tháng *</label>
                            <input asp-for="Thang" type="number" min="1" max="12" class="form-control" required />
                        </div>

                        <div class="form-group col-md-2 mb-4">
                            <label asp-for="Nam" class="editorial-label">Năm *</label>
                            <input asp-for="Nam" type="number" min="2020" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="DienCu" class="editorial-label">Chỉ số Điện cũ (kWh) *</label>
                            <input asp-for="DienCu" type="number" min="0" class="form-control" required />
                        </div>
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="DienMoi" class="editorial-label">Chỉ số Điện mới (≥ Điện cũ) *</label>
                            <input asp-for="DienMoi" type="number" min="0" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="NuocCu" class="editorial-label">Chỉ số Nước cũ (Khối) *</label>
                            <input asp-for="NuocCu" type="number" min="0" class="form-control" required />
                        </div>
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="NuocMoi" class="editorial-label">Chỉ số Nước mới (≥ Nước cũ) *</label>
                            <input asp-for="NuocMoi" type="number" min="0" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label class="editorial-label">Bộ ảnh chụp đồng hồ Điện & Nước (@dsAnhHienTai.Length ảnh hiện có)</label>
                        <div class="p-3" style="background-color: #FAFAFA; border: 1px dashed #D1D5DB; border-radius: 2px;">
                            @if (dsAnhHienTai.Length > 0)
                            {
                                <div class="small font-weight-bold text-muted mb-2">
                                    Các ảnh đang lưu (Bỏ tích nếu muốn gỡ bớt ảnh, bấm vào ảnh để phóng to):
                                </div>
                                <div class="d-flex flex-wrap mb-3" style="gap: 0.75rem;">
                                    @for (int i = 0; i < dsAnhHienTai.Length; i++)
                                    {
                                        var url = dsAnhHienTai[i];
                                        <div class="p-2 bg-white" style="border: 1px solid #E5E7EB; border-radius: 2px; width: 165px;">
                                            <img src="@url" alt="Ảnh @(i + 1)"
                                                 onclick="phongToAnhEdit('@url', 'Ảnh minh chứng #@(i + 1)')"
                                                 style="width: 100%; height: 115px; object-fit: cover; cursor: zoom-in; border: 1px solid #F3F4F6;" />
                                            <div class="custom-control custom-checkbox mt-2">
                                                <input type="checkbox" class="custom-control-input" id="chkAnh_@i" name="anhGiuLai" value="@url" checked />
                                                <label class="custom-control-label small font-weight-bold" for="chkAnh_@i" style="color: #111827;">
                                                    Giữ lại ảnh #@(i + 1)
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <label class="small font-weight-bold d-block" style="color: #059669;">
                                + Tải thêm ảnh đồng hồ mới từ máy tính (Có thể chọn nhiều ảnh):
                            </label>
                            <input type="file" name="filesAnhDongHo" multiple accept=".jpg,.jpeg,.png,.webp,image/*" class="form-control-file" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-save fa-sm mr-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PHÓNG TO ẢNH TRÊN TRANG EDIT -->
<div class="modal fade" id="modalAnhEdit" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 2px;">
            <div class="modal-header">
                <h5 class="modal-title font-weight-bold" id="lblModalEdit" style="color: #111827;"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center" style="background-color: #111827;">
                <img id="imgModalEdit" src="#" class="img-fluid" style="max-height: 75vh;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function phongToAnhEdit(url, title) {
            document.getElementById('lblModalEdit').innerText = title;
            document.getElementById('imgModalEdit').src = url;
            $('#modalAnhEdit').modal('show');
        }
    </script>
}