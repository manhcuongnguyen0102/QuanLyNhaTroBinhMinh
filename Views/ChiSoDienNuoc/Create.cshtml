@model QuanLyNhaTroBinhMinh.Models.ChiSoDienNuoc

@{
    ViewData["Title"] = "Ghi chỉ số điện nước";
}

<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">CHỐT ĐỒNG HỒ HÀNG THÁNG</span>
        <h1 class="editorial-title mb-1">Ghi chỉ số điện nước mới</h1>
        <p class="editorial-subtitle mb-0">Khi chọn phòng, hệ thống sẽ tự động lấy chỉ số mới của tháng trước điền vào ô chỉ số cũ.</p>
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert-editorial-danger mb-4"
         style="background-color: #FEF2F2; border: 1px solid #F87171; color: #991B1B; padding: 1rem 1.25rem; border-radius: 2px; font-weight: 600;">
        <div class="mb-1"><i class="fas fa-exclamation-triangle mr-2" style="color: #DC2626;"></i>Vui lòng kiểm tra lại dữ liệu chỉ số:</div>
        <div asp-validation-summary="All" class="small mb-0"></div>
    </div>
}

<div class="row">
    <div class="col-xl-8 col-lg-10">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Phiếu chốt chỉ số đồng hồ</span>
                <span id="thongBaoChiSoCu" class="badge-editorial-mint">Chọn phòng để tự động nạp chỉ số cũ</span>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="form-row">
                        <div class="form-group col-md-3 mb-4">
                            <label asp-for="MaChiSo" class="editorial-label">Mã phiếu chốt *</label>
                            <input asp-for="MaChiSo" class="form-control" required />
                            <span asp-validation-for="MaChiSo" class="text-danger small font-weight-bold"></span>
                        </div>

                        <div class="form-group col-md-5 mb-4">
                            <label asp-for="MaPhong" class="editorial-label">Chọn phòng trọ *</label>
                            <select asp-for="MaPhong" asp-items="ViewBag.DanhSachPhong" class="form-control" id="selectMaPhong" required>
                                <option value="">-- Chọn phòng cần chốt --</option>
                            </select>
                            <span asp-validation-for="MaPhong" class="text-danger small font-weight-bold"></span>
                        </div>

                        <div class="form-group col-md-2 mb-4">
                            <label asp-for="Thang" class="editorial-label">Tháng *</label>
                            <input asp-for="Thang" type="number" min="1" max="12" class="form-control" id="inputThang" required />
                        </div>

                        <div class="form-group col-md-2 mb-4">
                            <label asp-for="Nam" class="editorial-label">Năm *</label>
                            <input asp-for="Nam" type="number" min="2020" class="form-control" id="inputNam" required />
                        </div>
                    </div>

                    <!-- KHỐI CHỈ SỐ ĐIỆN -->
                    <div class="p-3 mb-4" style="background-color: #FAFAFA; border: 1px solid #E5E7EB; border-radius: 2px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <strong style="color: #111827;"><i class="fas fa-bolt mr-2" style="color: #059669;"></i>CHỈ SỐ ĐỒNG HỒ ĐIỆN (kWh)</strong>
                            <span class="status-badge-available" id="lblTieuThuDien">Tiêu thụ: 0 kWh</span>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-0">
                                <label asp-for="DienCu" class="editorial-label">Chỉ số Điện cũ *</label>
                                <input asp-for="DienCu" type="number" min="0" class="form-control" id="inputDienCu" required />
                            </div>
                            <div class="form-group col-md-6 mb-0">
                                <label asp-for="DienMoi" class="editorial-label">Chỉ số Điện mới (Phải ≥ Điện cũ) *</label>
                                <input asp-for="DienMoi" type="number" min="0" class="form-control" id="inputDienMoi" required />
                                <span asp-validation-for="DienMoi" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- KHỐI CHỈ SỐ NƯỚC -->
                    <div class="p-3 mb-4" style="background-color: #FAFAFA; border: 1px solid #E5E7EB; border-radius: 2px;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <strong style="color: #111827;"><i class="fas fa-tint mr-2" style="color: #059669;"></i>CHỈ SỐ ĐỒNG HỒ NƯỚC (Khối)</strong>
                            <span class="status-badge-available" id="lblTieuThuNuoc">Tiêu thụ: 0 Khối</span>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6 mb-0">
                                <label asp-for="NuocCu" class="editorial-label">Chỉ số Nước cũ *</label>
                                <input asp-for="NuocCu" type="number" min="0" class="form-control" id="inputNuocCu" required />
                            </div>
                            <div class="form-group col-md-6 mb-0">
                                <label asp-for="NuocMoi" class="editorial-label">Chỉ số Nước mới (Phải ≥ Nước cũ) *</label>
                                <input asp-for="NuocMoi" type="number" min="0" class="form-control" id="inputNuocMoi" required />
                                <span asp-validation-for="NuocMoi" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- KHỐI TẢI NHIỀU ẢNH ĐỒNG HỒ ĐIỆN & NƯỚC TỪ MÁY TÍNH -->
                    <div class="form-group mb-5">
                        <label class="editorial-label">Ảnh chụp đồng hồ chứng minh số Điện & số Nước </label>
                        <div class="p-3" style="background-color: #FAFAFA; border: 1px dashed #D1D5DB; border-radius: 2px;">
                            <div class="d-flex flex-wrap align-items-center justify-content-between">
                                <input type="file" name="filesAnhDongHo" id="inputAnhDongHo" multiple
                                       accept=".jpg,.jpeg,.png,.webp,image/*"
                                       class="form-control-file" style="font-size: 0.9rem; color: #111827; max-width: 70%;" />
                                <button type="button" id="btnXoaTatCaAnh" class="btn btn-secondary btn-sm py-1 px-2 d-none" onclick="xoaTatCaAnhDaChon()">
                                    Xóa chọn lại
                                </button>
                            </div>
                            

                            <!-- Lưới hiển thị tất cả các ảnh đã chọn + Bấm vào để phóng to -->
                            <div id="khungXemTruocAnh" class="mt-3 d-none">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small font-weight-bold" style="color: #059669;" id="lblSoAnhDaChon">Đã chọn 0 ảnh:</span>
                                    <button type="button" class="btn btn-link btn-sm p-0" style="color: #059669; font-weight: 700; text-decoration: none;" onclick="moModalPhongToTatCa()">
                                        <i class="fas fa-search-plus mr-1"></i>Phóng to tất cả ảnh
                                    </button>
                                </div>
                                <div id="danhSachThumbnail" class="d-flex flex-wrap" style="gap: 0.75rem;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-check fa-sm mr-2"></i>Lưu chỉ số điện nước
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PHÓNG TO XEM TẤT CẢ ẢNH ĐỒNG HỒ TRÊN TRANG CREATE -->
<div class="modal fade" id="modalXemAnhCreate" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 2px; border: 1px solid #E5E7EB;">
            <div class="modal-header" style="border-bottom: 1px solid #E5E7EB;">
                <h5 class="modal-title font-weight-bold" style="color: #111827;">
                    <i class="fas fa-camera mr-2" style="color: #059669;"></i>Kiểm tra ảnh chụp đồng hồ Điện & Nước
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="noiDungModalCreate" style="background-color: #F9FAFB; max-height: 80vh; overflow-y: auto;">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Bộ nhớ đệm lưu cộng dồn nhiều file ảnh khi chủ trọ chọn nhiều lần
        let boNhoFile = new DataTransfer();

        function capNhatSanLuong() {
            const dienCu = parseInt(document.getElementById('inputDienCu').value) || 0;
            const dienMoi = parseInt(document.getElementById('inputDienMoi').value) || 0;
            const nuocCu = parseInt(document.getElementById('inputNuocCu').value) || 0;
            const nuocMoi = parseInt(document.getElementById('inputNuocMoi').value) || 0;

            document.getElementById('lblTieuThuDien').innerText = `Tiêu thụ: ${Math.max(0, dienMoi - dienCu)} kWh`;
            document.getElementById('lblTieuThuNuoc').innerText = `Tiêu thụ: ${Math.max(0, nuocMoi - nuocCu)} Khối`;
        }

        async function tuDongNapChiSoCu() {
            const maPhong = document.getElementById('selectMaPhong').value;
            const thang = document.getElementById('inputThang').value;
            const nam = document.getElementById('inputNam').value;
            const badge = document.getElementById('thongBaoChiSoCu');

            if (!maPhong) return;

            const res = await fetch(`/ChiSoDienNuoc/LayChiSoCu?maPhong=${encodeURIComponent(maPhong)}&thang=${thang}&nam=${nam}`);
            const data = await res.json();

            document.getElementById('inputDienCu').value = data.dienCu;
            document.getElementById('inputNuocCu').value = data.nuocCu;

            if (parseInt(document.getElementById('inputDienMoi').value) < data.dienCu) {
                document.getElementById('inputDienMoi').value = data.dienCu;
            }
            if (parseInt(document.getElementById('inputNuocMoi').value) < data.nuocCu) {
                document.getElementById('inputNuocMoi').value = data.nuocCu;
            }

            badge.innerText = data.coDuLieuCu
                ? `Đã kế thừa chỉ số từ kỳ ${data.kyTruoc} (Điện: ${data.dienCu}, Nước: ${data.nuocCu})`
                : `Phòng chưa có lịch sử chốt trước đó (Mặc định Cũ = 0)`;

            capNhatSanLuong();
        }

        // Xử lý chọn cộng dồn nhiều file ảnh & vẽ lưới Thumbnail
        document.getElementById('inputAnhDongHo').addEventListener('change', function (e) {
            for (let file of e.target.files) {
                boNhoFile.items.add(file);
            }
            this.files = boNhoFile.files;
            veLuoiAnhXemTruoc();
        });

        function xoaMotAnhDaChon(index) {
            const dtMoi = new DataTransfer();
            for (let i = 0; i < boNhoFile.files.length; i++) {
                if (i !== index) dtMoi.items.add(boNhoFile.files[i]);
            }
            boNhoFile = dtMoi;
            document.getElementById('inputAnhDongHo').files = boNhoFile.files;
            veLuoiAnhXemTruoc();
        }

        function xoaTatCaAnhDaChon() {
            boNhoFile = new DataTransfer();
            document.getElementById('inputAnhDongHo').value = '';
            veLuoiAnhXemTruoc();
        }

        function veLuoiAnhXemTruoc() {
            const container = document.getElementById('khungXemTruocAnh');
            const listDiv = document.getElementById('danhSachThumbnail');
            const btnXoaAll = document.getElementById('btnXoaTatCaAnh');
            const lblCount = document.getElementById('lblSoAnhDaChon');

            listDiv.innerHTML = '';
            const files = boNhoFile.files;

            if (files.length === 0) {
                container.classList.add('d-none');
                btnXoaAll.classList.add('d-none');
                return;
            }

            container.classList.remove('d-none');
            btnXoaAll.classList.remove('d-none');
            lblCount.innerText = `Đã đính kèm ${files.length} ảnh minh chứng (Bấm vào ảnh để phóng to):`;

            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const card = document.createElement('div');
                    card.style.cssText = 'position: relative; border: 1px solid #E5E7EB; background: #FFF; padding: 6px; border-radius: 2px; width: 150px;';
                    card.innerHTML = `
                        <div class="small font-weight-bold text-muted mb-1 text-truncate" title="${file.name}">
                            Ảnh #${idx + 1}: ${idx === 0 ? 'Điện/Nước' : 'Đồng hồ'}
                        </div>
                        <img src="${ev.target.result}" alt="Ảnh ${idx + 1}"
                             onclick="moModalPhongToTatCa()"
                             style="width: 100%; height: 110px; object-fit: cover; cursor: zoom-in; border: 1px solid #F3F4F6;" />
                        <button type="button" onclick="xoaMotAnhDaChon(${idx})"
                                class="btn btn-sm btn-link text-danger p-0 mt-1 d-block w-100 text-center"
                                style="font-size: 0.75rem; font-weight: 700; text-decoration: none;">
                            ✕ Gỡ ảnh này
                        </button>
                    `;
                    listDiv.appendChild(card);
                };
                reader.readAsDataURL(file);
            });
        }

        function moModalPhongToTatCa() {
            const modalBody = document.getElementById('noiDungModalCreate');
            modalBody.innerHTML = '';
            const files = boNhoFile.files;

            if (files.length === 0) return;

            const row = document.createElement('div');
            row.className = 'row';

            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function (ev) {
                    const col = document.createElement('div');
                    col.className = files.length === 1 ? 'col-12 mb-3' : 'col-md-6 mb-4';
                    col.innerHTML = `
                        <div class="p-3 bg-white" style="border: 1px solid #E5E7EB; border-radius: 2px;">
                            <div class="font-weight-bold mb-2" style="color: #111827;">
                                <span class="badge-editorial-mint mr-2">ẢNH #${idx + 1}</span> ${file.name}
                            </div>
                            <img src="${ev.target.result}" class="img-fluid w-100" style="max-height: 550px; object-fit: contain; background: #111827;" />
                        </div>
                    `;
                    row.appendChild(col);
                };
                reader.readAsDataURL(file);
            });

            modalBody.appendChild(row);
            $('#modalXemAnhCreate').modal('show');
        }

        document.getElementById('selectMaPhong').addEventListener('change', tuDongNapChiSoCu);
        document.getElementById('inputThang').addEventListener('change', tuDongNapChiSoCu);
        document.getElementById('inputNam').addEventListener('change', tuDongNapChiSoCu);
        ['inputDienCu', 'inputDienMoi', 'inputNuocCu', 'inputNuocMoi'].forEach(id => {
            document.getElementById(id).addEventListener('input', capNhatSanLuong);
        });
    </script>
}