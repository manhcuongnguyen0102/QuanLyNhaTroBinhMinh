@model IEnumerable<QuanLyNhaTroBinhMinh.Models.HopDong>

@{
    ViewData["Title"] = "Quản lý hợp đồng thuê";
    string? trangThaiHienTai = ViewBag.TrangThaiHienTai as string;
    var homNay = DateOnly.FromDateTime(DateTime.Today);
}

<!-- TẦNG 1 (TIÊU ĐỀ LỚN) & TẦNG 2 (PRIMARY CTA TƯƠNG PHẢN MẠNH NHẤT) -->
<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">QUẢN LÝ LƯU TRÚ</span>
        <h1 class="editorial-title mb-1">Hợp đồng thuê phòng</h1>
       
    </div>

    <div class="mt-4 mt-sm-0">
        <a asp-action="Create" class="btn btn-primary btn-editorial-cta">
            <i class="fas fa-plus fa-sm mr-2"></i>Lập hợp đồng mới
        </a>
    </div>
</div>

<!-- KHUNG THÔNG BÁO THÀNH CÔNG (XANH) & CẢNH BÁO LỖI (ĐỎ NỔI BẬT) -->
@if (TempData["ThongBao"] != null)
{
    <div class="p-3 mb-4 bg-editorial-mint d-flex justify-content-between align-items-center">
        <span><i class="fas fa-check-circle mr-2"></i>@TempData["ThongBao"]</span>
    </div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert-editorial-danger mb-4 d-flex justify-content-between align-items-center"
         style="background-color: #FEF2F2; border: 1px solid #F87171; color: #991B1B; padding: 1rem 1.25rem; border-radius: 2px; font-weight: 600;">
        <span><i class="fas fa-exclamation-triangle mr-2" style="color: #DC2626;"></i>@TempData["Loi"]</span>
    </div>
}

<!-- TẦNG 3 - THANH LỌC TRẠNG THÁI PHẲNG & TÌM KIẾM -->
<div class="d-lg-flex justify-content-between align-items-center mb-4">
    <div class="editorial-filter-bar mb-3 mb-lg-0">
        <a asp-action="Index" asp-route-trangThai=""
           class="editorial-filter-btn @(string.IsNullOrEmpty(trangThaiHienTai) ? "active" : "")">
            Tất cả (@ViewBag.TongHopDong)
        </a>
        <a asp-action="Index" asp-route-trangThai="Hiệu lực"
           class="editorial-filter-btn @(trangThaiHienTai == "Hiệu lực" ? "active" : "")">
            Hiệu lực (@ViewBag.DangHieuLuc)
        </a>
        <a asp-action="Index" asp-route-trangThai="Sắp hết hạn"
           class="editorial-filter-btn @(trangThaiHienTai == "Sắp hết hạn" ? "active" : "")">
            Sắp hết hạn ≤ 30 ngày (@ViewBag.SapHetHan)
        </a>
        <a asp-action="Index" asp-route-trangThai="Đã thanh lý"
           class="editorial-filter-btn @(trangThaiHienTai == "Đã thanh lý" ? "active" : "")">
            Đã thanh lý (@ViewBag.DaThanhLy)
        </a>
    </div>

    <form asp-action="Index" method="get" class="d-flex" style="min-width: 320px;">
        <input type="hidden" name="trangThai" value="@trangThaiHienTai" />
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoaHienTai"
               class="form-control mr-2" placeholder="Tìm mã HĐ, phòng, tài khoản..." />
        <button type="submit" class="btn btn-secondary px-3">
            <i class="fas fa-search"></i>
        </button>
    </form>
</div>

<!-- TẦNG 3 - BẢNG THỐNG KÊ CHUẨN SB ADMIN 2 -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Danh sách hồ sơ hợp đồng</span>
        <span class="text-muted small">Hiển thị @Model.Count() bản ghi</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table" width="100%" cellspacing="0">
                <thead>
                    <tr style="white-space: nowrap;">
                        <th>Mã HĐ</th>
                        <th>Phòng thuê</th>
                        <th>Tài khoản đại diện</th>
                        <th>Thời hạn thuê</th>
                        <th class="text-right">Tiền cọc</th>
                        <th class="text-center">Nhân khẩu</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Chưa có hợp đồng nào khớp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            bool daThanhLy = item.TrangThai == "Đã thanh lý";
                            bool sapHetHan = !daThanhLy && item.NgayKetThuc >= homNay && item.NgayKetThuc <= homNay.AddDays(30);

                            string rowStyle = daThanhLy ? "background-color: #F3F4F6; color: #6B7280;" : "";
                            string textColor = daThanhLy ? "#6B7280" : "#111827";

                            string pillStyle = daThanhLy
                            ? "background-color: #E5E7EB; color: #4B5563; border: 1px solid #D1D5DB; padding: 0.3rem 0.6rem; border-radius: 2px; font-weight: 600; font-size: 0.8rem; white-space: nowrap; display: inline-block;"
                            : "background-color: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 0.3rem 0.6rem; border-radius: 2px; font-weight: 600; font-size: 0.8rem; white-space: nowrap; display: inline-block;";

                            string statusStyle = daThanhLy
                            ? "background-color: #E5E7EB; color: #374151; border: 1px solid #D1D5DB; padding: 0.35rem 0.75rem; border-radius: 2px; font-weight: 700; font-size: 0.75rem; white-space: nowrap; display: inline-block;"
                            : (sapHetHan
                            ? "background-color: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; padding: 0.35rem 0.75rem; border-radius: 2px; font-weight: 700; font-size: 0.75rem; white-space: nowrap; display: inline-block;"
                            : "background-color: #ECFDF5; color: #059669; border: 1px solid #A7F3D0; padding: 0.35rem 0.75rem; border-radius: 2px; font-weight: 700; font-size: 0.75rem; white-space: nowrap; display: inline-block;");

                            <tr style="@rowStyle">
                                <td class="font-weight-bold" style="white-space: nowrap;">
                                    <a asp-action="Details" asp-route-id="@item.MaHopDong"
                                       style="color: @(daThanhLy ? "#6B7280" : "#059669"); text-decoration: none;">
                                        #@item.MaHopDong
                                    </a>
                                </td>

                                <td style="white-space: nowrap;">
                                    @if (item.MaPhongNavigation != null)
                                    {
                                        <span style="@pillStyle" class="mr-2">@item.MaPhong</span>
                                        <span class="font-weight-bold" style="color: @textColor;">@item.MaPhongNavigation.TenPhong</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa gán</span>
                                    }
                                </td>

                                <td style="white-space: nowrap;">
                                    @if (item.MaNguoiDungDaiDienNavigation != null)
                                    {
                                        <span style="color: @textColor; font-weight: 600;">@item.MaNguoiDungDaiDienNavigation.TenDangNhap</span>
                                        <small class="d-block text-muted">Mã: @item.MaNguoiDungDaiDien</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td style="white-space: nowrap;">
                                    <div style="color: @textColor; font-weight: 500;">
                                        @item.NgayBatDau.ToString("dd/MM/yyyy") → @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                    </div>
                                    @if (sapHetHan)
                                    {
                                        <small style="color: #B45309; font-weight: 600;">Sắp hết hạn</small>
                                    }
                                </td>

                                <td class="text-right font-weight-bold" style="color: @textColor; white-space: nowrap;">
                                    @(item.TienCoc.HasValue ? $"{item.TienCoc.Value:N0}đ" : "0đ")
                                </td>

                                <td class="text-center" style="white-space: nowrap;">
                                    <a asp-action="Details" asp-route-id="@item.MaHopDong" style="@pillStyle text-decoration: none;">
                                        @item.KhachOs.Count người
                                    </a>
                                </td>

                                <td class="text-center" style="white-space: nowrap;">
                                    <span style="@statusStyle">@(item.TrangThai ?? "Chưa rõ")</span>
                                </td>

                                <td class="text-right" style="white-space: nowrap;">
                                    @if (daThanhLy)
                                    {
                                        <!-- Hợp đồng Đã thanh lý: Khóa quyền Sửa, chỉ cho Xem hồ sơ lịch sử -->
                                        <a asp-action="Details" asp-route-id="@item.MaHopDong" class="btn btn-secondary btn-sm py-1 px-3">
                                            Xem hồ sơ
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.MaHopDong" class="btn btn-secondary btn-sm py-1 px-2 mr-1">
                                            Chi tiết & Khách ở
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaHopDong" class="btn btn-secondary btn-sm py-1 px-2">
                                            Sửa
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>