@model QuanLyNhaTroBinhMinh.Models.NguoiDung

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    bool laAdminGoc = Model.MaNguoiDung == "ND_ADMIN01";
}

<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">CẬP NHẬT TÀI KHOẢN & MẬT KHẨU</span>
        <h1 class="editorial-title mb-1">Tài khoản: @Model.TenDangNhap</h1>
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="card">
            <div class="card-header">Hồ sơ tài khoản — Mã: @Model.MaNguoiDung</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="form-row">
                        <div class="form-group col-md-5 mb-4">
                            <label asp-for="MaNguoiDung" class="editorial-label">Mã người dùng</label>
                            <input asp-for="MaNguoiDung" class="form-control" readonly style="background-color: #F9FAFB !important;" />
                        </div>

                        <div class="form-group col-md-7 mb-4">
                            <label asp-for="MaVaiTro" class="editorial-label">Vai trò phân quyền *</label>
                            <select asp-for="MaVaiTro" asp-items="ViewBag.DanhSachVaiTro" class="form-control" disabled="@laAdminGoc"></select>
                            @if (laAdminGoc)
                            {
                                <input type="hidden" asp-for="MaVaiTro" />
                            }
                        </div>
                    </div>

                    <div class="form-row mb-4">
                        <div class="form-group col-md-6">
                            <label asp-for="TenDangNhap" class="editorial-label">Tên đăng nhập *</label>
                            <input asp-for="TenDangNhap" class="form-control" required />
                        </div>

                        <div class="form-group col-md-6">
                            <label asp-for="MatKhau" class="editorial-label">Mật khẩu *</label>
                            <input asp-for="MatKhau" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="TrangThai" class="editorial-label">Trạng thái hoạt động</label>
                        <select asp-for="TrangThai" class="form-control" disabled="@laAdminGoc">
                            <option value="Hoạt động">Hoạt động (Cho phép đăng nhập)</option>
                            <option value="Khóa">Khóa (Chặn đăng nhập)</option>
                        </select>
                        @if (laAdminGoc)
                        {
                            <input type="hidden" asp-for="TrangThai" value="Hoạt động" />
                        }
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-save fa-sm mr-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>