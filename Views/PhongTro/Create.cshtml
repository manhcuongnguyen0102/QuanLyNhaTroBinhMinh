@model QuanLyNhaTroBinhMinh.Models.PhongTro

@{
    ViewData["Title"] = "Thêm phòng mới";
}

<!-- TIÊU ĐỀ TRANG & NÚT QUAY LẠI -->
<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">THIẾT LẬP HẠ TẦNG</span>
        <h1 class="editorial-title mb-1">Thêm phòng trọ mới</h1>
       
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

<!-- KHUNG BIỂU MẪU RỘNG RÃI (ĐẢM BẢO WHITESPACE >= 25%) -->
<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <div class="card-header">
                Thông tin chi tiết phòng trọ
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="form-row">
                        <div class="form-group col-md-5 mb-4">
                            <label asp-for="MaPhong" class="editorial-label">Mã phòng (Khóa chính) *</label>
                            <input asp-for="MaPhong" class="form-control" placeholder="VD: P101, P102..." required />
                            <span asp-validation-for="MaPhong" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-7 mb-4">
                            <label asp-for="TenPhong" class="editorial-label">Tên hiển thị phòng *</label>
                            <input asp-for="TenPhong" class="form-control" placeholder="VD: Phòng 101 - Tầng 1" required />
                            <span asp-validation-for="TenPhong" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="GiaThueCung" class="editorial-label">Giá thuê cứng (VNĐ/tháng) *</label>
                            <input asp-for="GiaThueCung" type="number" step="1000" min="0" class="form-control" placeholder="VD: 3500000" required />
                            <span asp-validation-for="GiaThueCung" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="DienTich" class="editorial-label">Diện tích (m²)</label>
                            <input asp-for="DienTich" type="number" step="0.1" min="0.1" class="form-control" placeholder="VD: 25" />
                            <span asp-validation-for="DienTich" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="TrangThai" class="editorial-label">Trạng thái ban đầu</label>
                        <select asp-for="TrangThai" class="form-control">
                            <option value="Trống">Trống (Sẵn sàng đón khách)</option>
                            <option value="Đang thuê">Đang thuê</option>
                            <option value="Bảo trì">Bảo trì / Sửa chữa</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <!-- Cụm nút hành động phân cấp rõ ràng -->
                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-check fa-sm mr-2"></i>Lưu thông tin phòng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}