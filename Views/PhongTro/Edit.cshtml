@model QuanLyNhaTroBinhMinh.Models.PhongTro

@{
    ViewData["Title"] = "Chỉnh sửa phòng trọ";
}

<!-- TIÊU ĐỀ TRANG & NÚT QUAY LẠI -->
<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">CẬP NHẬT HẠ TẦNG</span>
        <h1 class="editorial-title mb-1">Chỉnh sửa: @Model.TenPhong</h1>
        
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

<!-- KHUNG BIỂU MẪU CHỈNH SỬA -->
<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <div class="card-header">
                Hồ sơ kỹ thuật — Mã phòng: @Model.MaPhong
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="form-row">
                        <div class="form-group col-md-5 mb-4">
                            <label asp-for="MaPhong" class="editorial-label">Mã phòng (Cố định)</label>
                            <input asp-for="MaPhong" class="form-control" readonly style="background-color: #F9FAFB !important; color: #6B7280 !important;" />
                        </div>

                        <div class="form-group col-md-7 mb-4">
                            <label asp-for="TenPhong" class="editorial-label">Tên hiển thị phòng *</label>
                            <input asp-for="TenPhong" class="form-control" required />
                            <span asp-validation-for="TenPhong" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="GiaThueCung" class="editorial-label">Giá thuê cứng (VNĐ/tháng) *</label>
                            <input asp-for="GiaThueCung" type="number" step="1000" min="0" class="form-control" required />
                            <span asp-validation-for="GiaThueCung" class="text-danger small"></span>
                        </div>

                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="DienTich" class="editorial-label">Diện tích (m²)</label>
                            <input asp-for="DienTich" type="number" step="0.1" min="0.1" class="form-control" />
                            <span asp-validation-for="DienTich" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="TrangThai" class="editorial-label">Trạng thái phòng *</label>
                        @if (ViewBag.DangCoHopDongHieuLuc == true)
                        {
                            <!-- Khóa cứng không cho bấm đổi trạng thái nếu phòng đang có Hợp đồng Hiệu lực -->
                            <input type="hidden" asp-for="TrangThai" value="Đang thuê" />
                            <input type="text" class="form-control font-weight-bold" value="Đang thuê" readonly
                                   style="background-color: #ECFDF5 !important; color: #059669 !important; border-color: #A7F3D0 !important;" />
                            <small class="text-muted d-block mt-1">
                                <i class="fas fa-lock mr-1" style="color: #059669;"></i>Trạng thái được khóa tự động. Muốn trả phòng về "Trống", vui lòng vào mục <strong>Hợp đồng thuê → Thanh lý</strong>.
                            </small>
                        }
                        else
                        {
                            <select asp-for="TrangThai" class="form-control">
                                <option value="Trống">Trống (Sẵn sàng đón khách)</option>
                                <option value="Đang sửa">Đang sửa (Tạm ngưng đón khách)</option>
                            </select>
                        }
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-save fa-sm mr-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}