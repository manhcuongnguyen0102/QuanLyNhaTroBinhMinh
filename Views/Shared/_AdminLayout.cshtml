<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Nhà trọ Bình Minh</title>

    <!-- Icons từ SB Admin 2 -->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">

    <!-- Font Plus Jakarta Sans (Hỗ trợ tiếng Việt chuẩn Editorial) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Khung lõi SB Admin 2 (Giữ nguyên hệ thống lưới và bảng thống kê) -->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">

    <!-- Ghi đè giao diện Editorial Minimalist -->
    <link href="~/css/editorial-minimalist.css" rel="stylesheet">
</head>

<body id="page-top">
    <div id="wrapper">

        <!-- Giữ chỗ cho Sidebar (bạn tự quản lý) -->
        <partial name="_Sidebar" />

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">

                <!-- Thanh điều hướng trên cùng -->
                <partial name="_Topbar" />

                <!-- Không gian nội dung chính (Đảm bảo >= 25% Whitespace) -->
                <div class="container-fluid">
                    @RenderBody()
                </div>

            </div>

            <!-- Chân trang tối giản -->
            <partial name="_Footer" />
        </div>


    </div>

    <!-- Core Scripts của SB Admin 2 -->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>