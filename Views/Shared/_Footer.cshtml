<footer class="sticky-footer bg-white" style="border-top: 1px solid #E5E7EB; padding: 1.5rem 4.5rem;">
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">Bản quyền &copy; @DateTime.Now.Year — Quản Lý Nhà Trọ Bình Minh</span>
        <span class="text-muted">Editorial Minimalist UI v1.0</span>
    </div>
    <!-- MODAL ĐỔI MẬT KHẨU DÀNH CHO CHỦ TRỌ -->
    <div class="modal fade" id="modalDoiMatKhauAdmin" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content" style="border-radius: 2px; border: 1px solid #E5E7EB;">
                <div class="modal-header" style="border-bottom: 1px solid #E5E7EB;">
                    <h5 class="modal-title font-weight-bold" style="color: #111827;">
                        <i class="fas fa-user-shield mr-2" style="color: #059669;"></i>Đổi mật khẩu Chủ trọ
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form asp-controller="Account" asp-action="DoiMatKhau" method="post">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <label class="editorial-label">Mật khẩu hiện tại *</label>
                            <input type="password" name="matKhauCu" class="form-control" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="editorial-label">Mật khẩu mới *</label>
                            <input type="password" name="matKhauMoi" class="form-control" minlength="4" required />
                        </div>
                        <div class="form-group mb-0">
                            <label class="editorial-label">Xác nhận mật khẩu mới *</label>
                            <input type="password" name="xacNhanMatKhau" class="form-control" minlength="4" required />
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #E5E7EB;">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">Lưu mật khẩu mới</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</footer>