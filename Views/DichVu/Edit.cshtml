@model QuanLyNhaTroBinhMinh.Models.DichVu

@{
    ViewData["Title"] = "Chỉnh sửa đơn giá dịch vụ";
    bool laDienNuoc = Model.MaDichVu == "DV_DIEN" || Model.MaDichVu == "DV_NUOC";
}

<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">CẬP NHẬT ĐƠN GIÁ</span>
        <h1 class="editorial-title mb-1">Chỉnh sửa: @Model.TenDichVu</h1>
        <p class="editorial-subtitle mb-0">Đơn giá mới sẽ được áp dụng cho các kỳ xuất hóa đơn tiếp theo.</p>
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <div class="card-header">Hồ sơ dịch vụ — Mã: @Model.MaDichVu</div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div class="form-row">
                        <div class="form-group col-md-5 mb-4">
                            <label asp-for="MaDichVu" class="editorial-label">Mã dịch vụ (Cố định)</label>
                            <input asp-for="MaDichVu" class="form-control" readonly style="background-color: #F9FAFB !important;" />
                        </div>

                        <div class="form-group col-md-7 mb-4">
                            <label asp-for="TenDichVu" class="editorial-label">Tên dịch vụ *</label>
                            <input asp-for="TenDichVu" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="DonGia" class="editorial-label">Đơn giá (VNĐ) *</label>
                            <input asp-for="DonGia" type="number" step="500" min="0" class="form-control" required />
                            <span asp-validation-for="DonGia" class="text-danger small font-weight-bold"></span>
                        </div>

                        <div class="form-group col-md-6 mb-4">
                            <label asp-for="DonViTinh" class="editorial-label">Đơn vị tính *</label>
                            <input asp-for="DonViTinh" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="LaCoDinh" class="editorial-label">Cách thức tính tiền</label>
                        @if (laDienNuoc)
                        {
                            <input type="hidden" asp-for="LaCoDinh" value="false" />
                            <input type="text" class="form-control" value="Tính theo chỉ số đồng hồ (Mặc định hệ thống)" readonly style="background-color: #F9FAFB !important;" />
                        }
                        else
                        {
                            <select asp-for="LaCoDinh" class="form-control">
                                <option value="true">Phí cố định hàng tháng (Tự động nhân Số lượng = 1)</option>
                                <option value="false">Tính theo chỉ số đồng hồ</option>
                            </select>
                        }
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-save fa-sm mr-2"></i>Lưu đơn giá mới
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>