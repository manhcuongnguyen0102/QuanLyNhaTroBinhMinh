@model QuanLyNhaTroBinhMinh.Models.SuCo

@{
    ViewData["Title"] = "Ghi nhận sự cố mới";
}

<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">BẢO TRÌ THIẾT BỊ & CƠ SỞ VẬT CHẤT</span>
        <h1 class="editorial-title mb-1">Ghi nhận sự cố mới</h1>
        <p class="editorial-subtitle mb-0">Tạo phiếu theo dõi sửa chữa thiết bị trong phòng hoặc khu vực sinh hoạt chung.</p>
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại danh sách</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <div class="card-header">Thông tin phiếu báo cáo sự cố</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="form-row">
                        <div class="form-group col-md-4 mb-4">
                            <label asp-for="MaSuCo" class="editorial-label">Mã sự cố *</label>
                            <input asp-for="MaSuCo" class="form-control" required />
                        </div>

                        <div class="form-group col-md-8 mb-4">
                            <label asp-for="MaPhong" class="editorial-label">Phòng xảy ra sự cố</label>
                            <select asp-for="MaPhong" asp-items="ViewBag.DanhSachPhong" class="form-control">
                                <option value="">-- Khu vực sinh hoạt chung / Hành lang --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="MoTa" class="editorial-label">Mô tả chi tiết hỏng hóc *</label>
                        <textarea asp-for="MoTa" rows="3" class="form-control" placeholder="VD: Bình nóng lạnh không vào điện, vòi nước bồn rửa bị rò rỉ..." required></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4 mb-4">
                            <label asp-for="MaNguoiDungBao" class="editorial-label">Tài khoản người báo</label>
                            <select asp-for="MaNguoiDungBao" asp-items="ViewBag.DanhSachNguoiDung" class="form-control"></select>
                        </div>

                        <div class="form-group col-md-4 mb-4">
                            <label asp-for="TrangThai" class="editorial-label">Trạng thái xử lý *</label>
                            <select asp-for="TrangThai" class="form-control">
                                <option value="Chờ xử lý">Chờ xử lý</option>
                                <option value="Đang sửa">Đang sửa</option>
                                <option value="Đã hoàn thành">Đã hoàn thành</option>
                            </select>
                        </div>

                        <div class="form-group col-md-4 mb-4">
                            <label asp-for="ChiPhiSua" class="editorial-label">Chi phí sửa chữa (VNĐ)</label>
                            <input asp-for="ChiPhiSua" type="number" min="0" step="1000" class="form-control" />
                        </div>
                    </div>

                    <div class="custom-control custom-checkbox mb-4">
                        <input type="checkbox" class="custom-control-input" id="chkDangSua" name="chuyenPhongSangDangSua" value="true" />
                        <label class="custom-control-label small font-weight-bold" for="chkDangSua" style="color: #111827;">
                            Đồng thời chuyển trạng thái Phòng này sang "Đang sửa" (nếu là phòng đang Trống cần tạm ngưng đón khách)
                        </label>
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-check fa-sm mr-2"></i>Lưu phiếu sự cố
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>