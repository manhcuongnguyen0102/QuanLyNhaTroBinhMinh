@model QuanLyNhaTroBinhMinh.Models.ThongBao

@{
    ViewData["Title"] = "Đăng thông báo mới";
}

<div class="d-sm-flex align-items-end justify-content-between mb-5 pb-3" style="border-bottom: 1px solid #E5E7EB;">
    <div>
        <span class="badge-editorial-mint mb-2 d-inline-block">TRUYỀN THÔNG NỘI BỘ</span>
        <h1 class="editorial-title mb-1">Phát hành thông báo mới</h1>
        <p class="editorial-subtitle mb-0">Nội dung sẽ hiển thị trực tiếp trên Cổng thông tin của toàn bộ khách thuê trọ.</p>
    </div>
    <div class="mt-4 mt-sm-0">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left fa-sm mr-2"></i>Quay lại bảng tin</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <div class="card-header">Soạn thảo bản tin nhà trọ</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="MaNguoiDungTao" />

                    <div class="form-row">
                        <div class="form-group col-md-4 mb-4">
                            <label asp-for="MaThongBao" class="editorial-label">Mã thông báo *</label>
                            <input asp-for="MaThongBao" class="form-control" required />
                        </div>

                        <div class="form-group col-md-8 mb-4">
                            <label asp-for="TieuDe" class="editorial-label">Tiêu đề thông báo *</label>
                            <input asp-for="TieuDe" class="form-control" placeholder="VD: Thông báo lịch đóng tiền trọ kỳ Tháng 10/2026" required />
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="NoiDung" class="editorial-label">Nội dung chi tiết *</label>
                        <textarea asp-for="NoiDung" rows="5" class="form-control" placeholder="Nhập nội dung thông báo gửi tới các phòng..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-end pt-3" style="border-top: 1px solid #E5E7EB;">
                        <a asp-action="Index" class="btn btn-secondary mr-3">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-editorial-cta">
                            <i class="fas fa-paper-plane fa-sm mr-2"></i>Phát hành ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>